NODE_ENV=development
PORT=3000
# MongoDB must support transactions: Atlas or a local replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/phulo?replicaSet=rs0&directConnection=true
FRONTEND_ORIGIN=http://localhost:5173
# Generate TWO DIFFERENT secrets, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=
CSRF_SECRET=
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SAME_SITE=lax
# Set only for the exact number of trusted reverse proxies in your deployment.
TRUST_PROXY_HOPS=0
# Resolved from apps/api when running npm scripts.
DATA_DIR=../../data
# Only for the explicit admin:create command; remove after creation.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
