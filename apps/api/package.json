{
  "name": "@phulo/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc",
    "check": "tsc --noEmit && tsc -p tests/tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "seed": "tsx --env-file=../../.env src/scripts/seed.ts",
    "admin:create": "tsx --env-file=../../.env src/scripts/create-admin.ts"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "mongoose": "^9.12.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
